{
  "name": "openapi-automatons",
  "version": "1.0.259",
  "repository": "https://github.com/openapi-automatons/openapi-automatons.git",
  "author": "tanmen <yt.prog@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/openapi-automatons/openapi-automatons#readme",
  "bugs": {
    "url": "https://github.com/openapi-automatons/openapi-automatons/issues"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "keywords": [
    "openapi"
  ],
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "bin": {
    "openapi-automatons": "cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "depcheck",
    "build": "tsup && cp package.json README.md LICENSE dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@automatons/tools": "^2.2.27",
    "@automatons/validator": "^2.2.25",
    "chalk": "^5.3.0",
    "ora": "^9.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
